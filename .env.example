SCENEMIND_CORS_ORIGINS=["http://localhost:3000"]
# Optional single-host processing; use identical settings for API and worker.
SCENEMIND_DURABLE_JOBS=false
SCENEMIND_JOB_TIMEOUT=7200
SCENEMIND_INGEST_JOB_TIMEOUT=1800
SCENEMIND_ACQUIRE_JOB_TIMEOUT=900
SCENEMIND_SPEECH_JOB_TIMEOUT=7200
SCENEMIND_VISUAL_JOB_TIMEOUT=3600
SCENEMIND_JOB_ATTEMPTS=2
SCENEMIND_MAX_PENDING_JOBS=20
SCENEMIND_MAX_UPLOAD_BYTES=1073741824
SCENEMIND_MAX_DURATION=3600
SCENEMIND_PROCESSING_TIMEOUT=1800
SCENEMIND_MIN_FREE_DISK_BYTES=536870912
SCENEMIND_PROCESSING_DISK_HEADROOM_RATIO=0.25
SCENEMIND_URL_CONNECT_TIMEOUT=10
SCENEMIND_URL_READ_TIMEOUT=30
SCENEMIND_URL_ACQUIRE_TIMEOUT=600
SCENEMIND_URL_REDIRECT_LIMIT=5
# Ask Video sends only the question and retrieved transcript evidence to OpenAI.
# Keep the API key in ignored .env.local as OPENAI_API_KEY, never in this file.
SCENEMIND_QA_MODEL=gpt-5.4-mini
SCENEMIND_QA_ENABLED=false
SCENEMIND_QA_TIMEOUT=45
SCENEMIND_QA_RETRIES=1
SCENEMIND_QA_TOP_K=5
# Disable to make AUTO requests use the existing Hybrid path; explicit modes always remain available.
SCENEMIND_AUTO_ROUTING_ENABLED=true
# No no-match flag is exposed: the path-aware candidate failed frozen quality gates.
# Set privately for operator access (username scenemind).
SCENEMIND_AUTH_TOKEN=
# Enable only after reviewing a domain-appropriate artifact:
# SCENEMIND_CALIBRATION_PATH=data/calibration.json
